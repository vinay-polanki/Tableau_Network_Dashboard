      <aliases enabled='yes' />
      <column caption='Row Count' datatype='integer' name='[Calculation_166281345815855104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='resolved' datatype='string' datatype-customized='true' name='[Calculation_166281345850249218]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(COUNT(IF [Resolved] = &quot;Yes&quot; THEN 1 END) / COUNT([Resolved]))' />
      </column>
      <column caption='Resolved_Percentage' datatype='real' name='[Calculation_166281345851797507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#10;    IF STR([Resolved]) = &quot;Yes&quot; THEN 1 END&#10;) / &#10;COUNT([Resolved])' />
      </column>
      <column caption='Unresolved_Count' datatype='integer' name='[Calculation_206039686339489793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#10;    IF LOWER(TRIM(STR([Resolved]))) = &quot;no&quot; THEN 1 END&#10;)' />
      </column>
      <column caption='Critical Event %' datatype='real' name='[Calculation_799318568592543745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#10;    IF LOWER(TRIM([Severity])) = &quot;critical&quot; THEN 1 END&#10;) / COUNT([Severity])' />
      </column>
